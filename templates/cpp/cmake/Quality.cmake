function(project_quality target)
  if(MSVC)
    target_compile_options(${target} PRIVATE /W4 /permissive- /utf-8 /Zc:__cplusplus)
    target_compile_definitions(${target} PRIVATE _CRT_SECURE_NO_WARNINGS NOMINMAX WIN32_LEAN_AND_MEAN UNICODE _UNICODE)
    if(PROJECT_WARNINGS_AS_ERRORS)
      target_compile_options(${target} PRIVATE /WX)
    endif()
  else()
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Wshadow -Wconversion -Wsign-conversion
                                             -Wnon-virtual-dtor -Wold-style-cast -Woverloaded-virtual)
    if(PROJECT_WARNINGS_AS_ERRORS)
      target_compile_options(${target} PRIVATE -Werror)
    endif()
    if(WIN32)
      target_compile_definitions(${target} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN UNICODE _UNICODE)
    endif()
  endif()
  if(PROJECT_CHECKED)
    if(MSVC)
      target_compile_options(${target} PRIVATE /UNDEBUG /sdl)
      target_compile_definitions(${target} PRIVATE _CONTAINER_DEBUG_LEVEL=1)
    else()
      target_compile_options(${target} PRIVATE -UNDEBUG)
      target_compile_definitions(${target} PRIVATE _GLIBCXX_ASSERTIONS
                                                   _LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_EXTENSIVE)
    endif()
  endif()
  project_sanitize(${target})
endfunction()

function(project_sanitize target)
  if(PROJECT_FUZZ)
    set(flags -fsanitize=fuzzer-no-link,address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer)
    target_compile_options(${target} PRIVATE ${flags})
    target_link_options(${target} PRIVATE -fsanitize=address,undefined)
    return()
  endif()
  if(PROJECT_SANITIZE STREQUAL "")
    return()
  endif()
  if(MSVC)
    if(PROJECT_SANITIZE STREQUAL "address")
      target_compile_options(${target} PRIVATE /fsanitize=address)
    else()
      message(FATAL_ERROR "MSVC supports only PROJECT_SANITIZE=address")
    endif()
    return()
  endif()
  if(PROJECT_SANITIZE STREQUAL "address")
    set(flags -fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer)
  elseif(PROJECT_SANITIZE STREQUAL "thread")
    set(flags -fsanitize=thread -fno-omit-frame-pointer)
  else()
    message(FATAL_ERROR "PROJECT_SANITIZE must be address, thread or empty")
  endif()
  target_compile_options(${target} PRIVATE ${flags})
  target_link_options(${target} PRIVATE ${flags})
endfunction()
