set(CMAKE_SKIP_INSTALL_ALL_DEPENDENCY ON)

string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" package_processor)
if(package_processor MATCHES "^(x86_64|amd64)$")
  set(package_arch "x64")
elseif(package_processor MATCHES "^(arm64|aarch64)$")
  set(package_arch "arm64")
else()
  set(package_arch "${package_processor}")
endif()
if(WIN32)
  set(package_os "windows")
elseif(APPLE)
  set(package_os "macos")
else()
  set(package_os "linux")
endif()

set(package_stage "${CMAKE_CURRENT_BINARY_DIR}/package")
if(APPLE)
  set(APP_START_TEXT
      "Start: open \"${APP_NAME}.app\" (the first time: right-click, Open).\nCommand line: \"${APP_NAME}.app/Contents/MacOS/${APP_SLUG}\" --help"
  )
else()
  set(APP_START_TEXT
      "Start: usr/local/bin/${APP_SLUG}\nInstall for your user (no administrator rights): make user-install\nInstall for everyone: sudo make install"
  )
endif()
configure_file("${PROJECT_SOURCE_DIR}/packaging/README.txt.in" "${package_stage}/README.txt" @ONLY)
install(FILES "${PROJECT_SOURCE_DIR}/LICENSE" "${PROJECT_SOURCE_DIR}/THIRD_PARTY_NOTICES.md"
              "${PROJECT_SOURCE_DIR}/docs/USAGE.md" "${package_stage}/README.txt" DESTINATION ".")

if(APPLE)
  set(bundle "${APP_NAME}.app/Contents")
  configure_file("${PROJECT_SOURCE_DIR}/packaging/Info.plist.in" "${package_stage}/Info.plist" @ONLY)
  install(TARGETS ${APP_SLUG} RUNTIME DESTINATION "${bundle}/MacOS")
  install(FILES "${package_stage}/Info.plist" DESTINATION "${bundle}")
  install(FILES "${PROJECT_SOURCE_DIR}/assets/icon.icns" DESTINATION "${bundle}/Resources" RENAME "${APP_SLUG}.icns")
elseif(WIN32)
  install(TARGETS ${APP_SLUG} RUNTIME DESTINATION ".")
else()
  file(STRINGS "${PROJECT_SOURCE_DIR}/assets/${APP_SLUG}.desktop" desktop_lines)
  set(desktop_text "")
  foreach(line IN LISTS desktop_lines)
    if(line MATCHES "^Icon=")
      set(line "Icon=${APP_ID}")
    endif()
    string(APPEND desktop_text "${line}\n")
  endforeach()
  string(APPEND desktop_text "StartupWMClass=${APP_ID}\n")
  file(WRITE "${package_stage}/${APP_ID}.desktop" "${desktop_text}")
  configure_file("${PROJECT_SOURCE_DIR}/packaging/install.mk.in" "${package_stage}/Makefile" @ONLY)
  install(TARGETS ${APP_SLUG} RUNTIME DESTINATION "usr/local/bin")
  install(FILES "${package_stage}/${APP_ID}.desktop" DESTINATION "usr/local/share/applications")
  install(FILES "${PROJECT_SOURCE_DIR}/assets/linux/${APP_SLUG}.png" DESTINATION "usr/local/share/pixmaps" RENAME "${APP_ID}.png")
  install(FILES "${package_stage}/Makefile" DESTINATION ".")
endif()

set(CPACK_GENERATOR "TGZ")
set(CPACK_PACKAGE_NAME "${APP_SLUG}")
set(CPACK_PACKAGE_VENDOR "${APP_PUBLISHER}")
set(CPACK_PACKAGE_VERSION "${PROJECT_FULL_VERSION}")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "${APP_SUMMARY}")
set(CPACK_PACKAGE_FILE_NAME "${APP_SLUG}-${package_os}-${package_arch}")
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY ON)
set(CPACK_STRIP_FILES ON)
set(CPACK_VERBATIM_VARIABLES ON)
include(CPack)
